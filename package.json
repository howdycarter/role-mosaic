{
  "name": "role-mosaic",
  "version": "1.6.0",
  "private": true,
  "description": "A configurable, local-first job-search and application assistant.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "role-mosaic": "./bin/jev.js",
    "jev": "./bin/jev.js",
    "jev-job-search": "./bin/jev.js"
  },
  "scripts": {
    "jev": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts doctor",
    "doctor": "tsx src/cli.ts doctor",
    "discover": "tsx src/cli.ts discover",
    "apply": "tsx src/cli.ts apply",
    "tailor": "tsx src/cli.ts tailor",
    "log": "tsx src/cli.ts log",
    "status": "tsx src/cli.ts status",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "setup-applicant": "node scripts/setup-applicant.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "5.1.0"
  }
}
